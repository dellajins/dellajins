<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>hoverboard— Magical Games</title>
  <style>
    :root {
      --ink: #f7f0dc;
      --muted: #c9c0a9;
      --gold: #e7bd69;
      --violet: #9c7bea;
      --night: #11101e;
      --panel: rgba(31, 27, 49, 0.88);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(84, 62, 126, 0.45), transparent 55%),
        radial-gradient(circle at 15% 30%, rgba(231, 189, 105, 0.12) 1px, transparent 2px),
        radial-gradient(circle at 82% 18%, rgba(255, 255, 255, 0.35) 1px, transparent 2px),
        linear-gradient(160deg, #171327, #0d1421 65%, #10101a);
      background-size: auto, 110px 120px, 160px 140px, auto;
    }

    header {
      padding: 48px 20px 30px;
      text-align: center;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 0.82rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    h1 {
      margin: 10px 0;
      color: var(--gold);
      font-size: clamp(3rem, 9vw, 5.5rem);
      letter-spacing: 0.06em;
      text-shadow: 0 0 24px rgba(231, 189, 105, 0.25);
    }

    header p {
      max-width: 600px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.6;
    }

    main {
      width: min(100% - 32px, 920px);
      margin: 0 auto 60px;
    }

    .game {
      margin: 22px 0;
      padding: clamp(22px, 5vw, 38px);
      border: 1px solid rgba(231, 189, 105, 0.32);
      border-radius: 20px;
      background: var(--panel);
      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.3);
    }

    .game-label {
      color: var(--violet);
      font-size: 0.8rem;
      font-weight: bold;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    h2 {
      margin: 9px 0 12px;
      color: var(--gold);
      font-size: clamp(1.7rem, 5vw, 2.4rem);
    }

    .intro, .hint {
      color: var(--muted);
      line-height: 1.6;
    }

    .puzzle {
      margin-top: 24px;
      padding: 22px;
      border-left: 3px solid var(--violet);
      border-radius: 8px;
      background: rgba(10, 9, 20, 0.48);
    }

    .puzzle h3 {
      margin-top: 0;
      color: var(--ink);
      font-size: 1.25rem;
    }

    .answers, .spell-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    button {
      padding: 12px 18px;
      border: 1px solid rgba(231, 189, 105, 0.65);
      border-radius: 999px;
      color: var(--ink);
      font: inherit;
      cursor: pointer;
      background: rgba(115, 86, 164, 0.24);
      transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
    }

    button:hover, button:focus-visible {
      transform: translateY(-2px);
      border-color: var(--gold);
      background: rgba(156, 123, 234, 0.4);
      outline: none;
    }

    button:focus-visible {
      box-shadow: 0 0 0 3px rgba(231, 189, 105, 0.35);
    }

    .feedback, .spell-result {
      min-height: 1.6em;
      margin: 17px 0 0;
      color: var(--gold);
      line-height: 1.5;
    }

    .spell-area {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 0.85fr);
      gap: 28px;
      align-items: center;
      margin-top: 25px;
    }

    .flip-card {
      min-height: 250px;
      perspective: 1000px;
      cursor: pointer;
    }

    .flip-card-inner {
      position: relative;
      width: 100%;
      min-height: 250px;
      text-align: center;
      transition: transform 650ms ease;
      transform-style: preserve-3d;
    }

    .flip-card.is-flipped .flip-card-inner {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      inset: 0;
      display: grid;
      place-content: center;
      padding: 24px;
      border: 1px solid rgba(231, 189, 105, 0.65);
      border-radius: 16px;
      background:
        radial-gradient(circle at top, rgba(156, 123, 234, 0.3), transparent 65%),
        #211b34;
      backface-visibility: hidden;
      box-shadow: inset 0 0 30px rgba(231, 189, 105, 0.07);
    }

    .card-back {
      transform: rotateY(180deg);
      background:
        radial-gradient(circle at bottom, rgba(231, 189, 105, 0.18), transparent 65%),
        #211b34;
    }

    .card-face strong {
      display: block;
      color: var(--gold);
      font-size: clamp(1.3rem, 4vw, 1.8rem);
    }

    .card-face span {
      display: block;
      margin-top: 14px;
      color: var(--muted);
      line-height: 1.5;
    }

    .card-hint {
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.9rem;
      text-align: center;
    }

    footer {
      padding: 8px 20px 30px;
      color: var(--muted);
      text-align: center;
      font-size: 0.9rem;
    }

    @media (max-width: 650px) {
      .spell-area {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="eyebrow">A little magic awaits</div>
    <h1>hoverboard</h1>
    <p>
      Enter the enchanted study: solve its puzzles, then practice a few
      beginner-friendly spells.
    </p>
  </header>

  <main>
    <section class="game" aria-labelledby="puzzle-title">
      <div class="game-label">Game One · Puzzle Room</div>
      <h2 id="puzzle-title">The Riddle of the Floating Quill</h2>
      <p class="intro">
        A quill is hovering above a desk. Solve the riddle to discover what
        kind of magic might lift it.
      </p>

      <div class="puzzle">
        <h3>“I have pages, but I’m not a tree. I hold many worlds, but have no key. What am I?”</h3>
        <div class="answers" role="group" aria-label="Choose your answer">
          <button type="button" data-answer="book">A book</button>
          <button type="button" data-answer="cloud">A cloud</button>
          <button type="button" data-answer="mirror">A mirror</button>
        </div>
        <p class="feedback" id="puzzle-feedback" aria-live="polite"></p>
      </div>
    </section>

    <section class="game" aria-labelledby="spell-title">
      <div class="game-label">Final Game · Spell Practice</div>
      <h2 id="spell-title">The Enchanted Spellbook</h2>
      <p class="intro">
        Choose a spell to learn what it does. Then click the spell card to
        turn it over and reveal its practice note.
      </p>

      <div class="spell-buttons" role="group" aria-label="Choose a spell">
        <button type="button" data-spell="Lumos">Lumos</button>
        <button type="button" data-spell="Accio">Accio</button>
        <button type="button" data-spell="Wingardium Leviosa">Wingardium Leviosa</button>
      </div>
      <p class="spell-result" id="spell-result" aria-live="polite">
        Pick a spell to begin your practice.
      </p>

      <div class="spell-area">
        <div>
          <div
            class="flip-card"
            id="leviosa-card"
            role="button"
            tabindex="0"
            aria-label="Flip the Wingardium Leviosa spell card"
            aria-pressed="false"
          >
            <div class="flip-card-inner">
              <div class="card-face card-front">
                <div>
                  <strong>Wingardium Leviosa</strong>
                  <span>Tap or click to flip the card</span>
                </div>
              </div>
              <div class="card-face card-back">
                <div>
                  <strong>Lift with care</strong>
                  <span>
                    A levitation charm for floating objects. Imagine the object
                    rising gently, and guide it with a smooth wand movement.
                  </span>
                </div>
              </div>
            </div>
          </div>
          <p class="card-hint">The card flips to reveal the spell’s practice note.</p>
        </div>

        <div>
          <p class="hint">
            Spell buttons are for practice and storytelling. Try each one and
            watch the spellbook respond.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer>Made for curious minds and aspiring spellcasters ✦</footer>

  <script>
    const puzzleFeedback = document.querySelector("#puzzle-feedback");

    document.querySelectorAll("[data-answer]").forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.answer === "book") {
          puzzleFeedback.textContent =
            "Correct! A book holds many worlds. Your first puzzle is complete!";
        } else {
          puzzleFeedback.textContent =
            "Not quite. Think of something with pages that can hold stories.";
        }
      });
    });

    const spellDescriptions = {
      "Lumos": "Lumos — a little light for dark corridors.",
      "Accio": "Accio — a summoning charm for calling an object closer.",
      "Wingardium Leviosa":
        "Wingardium Leviosa — a levitation charm for making an object float."
    };

    const spellResult = document.querySelector("#spell-result");

    document.querySelectorAll("[data-spell]").forEach((button) => {
      button.addEventListener("click", () => {
        const spell = button.dataset.spell;
        spellResult.textContent = spellDescriptions[spell];

        if (spell === "Wingardium Leviosa") {
          document.querySelector("#leviosa-card").classList.add("is-flipped");
          document.querySelector("#leviosa-card").setAttribute("aria-pressed", "true");
        }
      });
    });

    const card = document.querySelector("#leviosa-card");

    function flipCard() {
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
    }

    card.addEventListener("click", flipCard);
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        flipCard();
      }
    });
  </script>
</body>
</html>

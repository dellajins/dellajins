<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hoverboard — Magical Games</title>
  <style>
    :root {
      --gold: #e7bd69;
      --violet: #9c7bea;
      --ink: #f8f2df;
      --muted: #c8bfaa;
      --panel: rgba(31, 27, 49, 0.92);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      background:
        radial-gradient(circle at 15% 20%, rgba(231, 189, 105, 0.12), transparent 20%),
        radial-gradient(circle at 85% 10%, rgba(156, 123, 234, 0.18), transparent 25%),
        linear-gradient(145deg, #171327, #0d1421 70%, #10101a);
    }

    header {
      padding: 45px 20px 24px;
      text-align: center;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 0.78rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    h1 {
      margin: 8px 0;
      color: var(--gold);
      font-size: clamp(3rem, 9vw, 5.5rem);
      letter-spacing: 0.07em;
      text-shadow: 0 0 25px rgba(231, 189, 105, 0.25);
    }

    header p {
      max-width: 610px;
      margin: 0 auto;
      color: var(--muted);
      line-height: 1.6;
    }

    main {
      width: min(100% - 32px, 980px);
      margin: 0 auto 60px;
    }

    .game {
      margin: 22px 0;
      padding: clamp(22px, 5vw, 38px);
      border: 1px solid rgba(231, 189, 105, 0.32);
      border-radius: 20px;
      background: var(--panel);
      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.3);
    }

    .game-label {
      color: var(--violet);
      font-size: 0.8rem;
      font-weight: bold;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    h2 {
      margin: 9px 0 12px;
      color: var(--gold);
      font-size: clamp(1.7rem, 5vw, 2.4rem);
    }

    .intro {
      color: var(--muted);
      line-height: 1.6;
    }

    .puzzle,
    .quiz-box,
    .house-box {
      margin-top: 24px;
      padding: 22px;
      border-left: 3px solid var(--violet);
      border-radius: 8px;
      background: rgba(10, 9, 20, 0.48);
    }

